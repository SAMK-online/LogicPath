# Copy to .env and fill in. Never commit .env.
ENV=development                       # development | production
DATABASE_URL=sqlite:///./backend/data/socratic.db
FRONTEND_ORIGIN=http://localhost:5180,http://127.0.0.1:5180 # comma-separated list of allowed browser origins

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"  (min 32 chars, required)
SESSION_SECRET=change-me-generate-a-real-secret-at-least-32-chars
SESSION_TTL_HOURS=168
COOKIE_SECURE=false                   # MUST be true behind HTTPS (required when ENV=production)
COOKIE_SAMESITE=lax                   # lax | strict | none (none needs COOKIE_SECURE=true; for cross-site deployments)

# Rate limits "<requests>/<window seconds>", in-process (single worker)
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10/60
CHAT_RATE_LIMIT=20/60

# --- AI tutor ---
LLM_PROVIDER=mock                     # mock (clearly-labelled canned replies, no key) | anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5             # e.g. claude-sonnet-5-5 is a cheaper option
LLM_MAX_OUTPUT_TOKENS=2048            # includes the model's thinking tokens
LLM_TIMEOUT_SECONDS=45
LLM_PROMPT_CACHING=true
CHAT_HISTORY_LIMIT=8                  # recent chat messages sent to the model (2-20)
