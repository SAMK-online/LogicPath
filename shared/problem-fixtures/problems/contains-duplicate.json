{
  "id": "contains-duplicate",
  "title": "Contains Duplicate",
  "difficulty": "Easy",
  "topic": "Hash maps",
  "description": "Given a list of integers `nums`, return `True` if any value appears **at least twice**, and `False` if every element is distinct.",
  "function_signature": {
    "name": "contains_duplicate",
    "params": [
      {
        "name": "nums",
        "type": "List[int]"
      }
    ],
    "return_type": "bool"
  },
  "starter_code": "from typing import List\n\n\ndef contains_duplicate(nums: List[int]) -> bool:\n    # Write your solution here\n    pass\n",
  "examples": [
    {
      "input": "nums = [1, 2, 3, 1]",
      "output": "True"
    },
    {
      "input": "nums = [1, 2, 3, 4]",
      "output": "False"
    }
  ],
  "constraints": [
    "`1 <= len(nums) <= 10**5`",
    "`-10**9 <= nums[i] <= 10**9`"
  ],
  "comparison": "exact",
