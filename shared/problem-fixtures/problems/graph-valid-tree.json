{
  "id": "graph-valid-tree",
  "title": "Graph Valid Tree",
  "difficulty": "Medium",
  "topic": "Graphs",
  "description": "You have a graph of `n` nodes labelled `0` to `n - 1`, and a list `edges` where `edges[i] = [a, b]` means there is an undirected edge between nodes `a` and `b`.\n\nReturn `True` if the edges make up a **valid tree**: every node is connected to every other, and there are no cycles. Otherwise return `False`.",
  "function_signature": {
    "name": "valid_tree",
    "params": [
      {
        "name": "n",
        "type": "int"
      },
      {
        "name": "edges",
        "type": "List[List[int]]"
      }
    ],
    "return_type": "bool"
  },
  "starter_code": "from typing import List\n\n\ndef valid_tree(n: int, edges: List[List[int]]) -> bool:\n    # Write your solution here\n    pass\n",
  "examples": [
    {
      "input": "n = 5, edges = [[0, 1], [0, 2], [0, 3], [1, 4]]",
      "output": "True"
    },
    {
      "input": "n = 5, edges = [[0, 1], [1, 2], [2, 3], [1, 3], [1, 4]]",
      "output": "False",
      "explanation": "Nodes 1, 2 and 3 form a cycle."
    }
  ],
  "constraints": [
    "`1 <= n <= 2 * 10**4`",
    "`0 <= len(edges) <= 2 * 10**4`",
    "`0 <= a, b < n` and `a != b`",
    "There are no repeated edges."
  ],
  "comparison": "exact",
  "test_cases": [
    {
      "id": 1,
      "args": [
        5,
        [
          [
            0,
            1
          ],
          [
            0,
            2
          ],
          [
            0,
            3
          ],
          [
            1,
            4
          ]
        ]
      ],
      "expected": true
    },
    {
      "id": 2,
      "args": [
        5,
        [
          [
            0,
            1
          ],
          [
            1,
            2
          ],
          [
            2,
            3
          ],
          [
            1,
            3
          ],
          [
            1,
            4
          ]
        ]
      ],
      "expected": false
    },
    {
      "id": 3,
      "args": [
        1,
        []
      ],
      "expected": true
    },
    {
      "id": 4,
      "args": [
        2,
        []
      ],
      "expected": false
    },
    {
      "id": 5,
      "args": [
        4,
        [
          [
            0,
            1
          ],
          [
            2,
            3
          ]
        ]
      ],
      "expected": false
    },
    {
      "id": 6,
      "args": [
        3,
        [
          [
            0,
            1
          ],
          [
            1,
            2
          ],
          [
            2,
            0
          ]
        ]
      ],
      "expected": false
    },
    {
      "id": 7,
      "args": [
        4,
        [
          [
            0,
            1
          ],
          [
            1,
            2
          ],
          [
            2,
            3
          ]
        ]
      ],
      "expected": true
    },
    {
      "id": 8,
      "args": [
        20000,
        {
          "$gen": "random_tree_edges",
          "n": 20000,
          "seed": 23
        }
      ],
      "expected": true,
      "perf": true,
      "label": "20,000 nodes joined into one tree",
      "time_limit_ms": 1000
    },
    {
      "id": 9,
      "args": [
        20000,
        {
          "$gen": "concat",
          "parts": [
            {
              "$gen": "random_tree_edges",
              "n": 20000,
              "seed": 23
            },
            [
              [
                0,
                19999
              ]
            ]
          ]
        }
      ],
      "expected": false,
      "perf": true,
      "label": "20,000 nodes, one edge too many",
      "time_limit_ms": 1000
    },
    {
      "id": 10,
      "args": [
        20000,
        {
          "$gen": "random_tree_edges",
          "n": 10000,
          "seed": 24
        }
      ],
      "expected": false,
      "perf": true,
      "label": "20,000 nodes, only 10,000 of them connected",
      "time_limit_ms": 1000
    }
  ]
}
