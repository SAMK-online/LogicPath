{
  "id": "number-of-connected-components-in-an-undirected-graph",
  "title": "Number of Connected Components in an Undirected Graph",
  "difficulty": "Medium",
  "topic": "Graphs",
  "description": "You have a graph of `n` nodes labelled `0` to `n - 1`, and a list `edges` where `edges[i] = [a, b]` means there is an undirected edge between nodes `a` and `b`.\n\nReturn the number of **connected components** in the graph: groups of nodes that can reach each other along edges. A node with no edges is a component of its own.",
  "function_signature": {
    "name": "count_components",
    "params": [
      {
        "name": "n",
        "type": "int"
      },
      {
        "name": "edges",
        "type": "List[List[int]]"
      }
    ],
    "return_type": "int"
  },
  "starter_code": "from typing import List\n\n\ndef count_components(n: int, edges: List[List[int]]) -> int:\n    # Write your solution here\n    pass\n",
  "examples": [
    {
      "input": "n = 5, edges = [[0, 1], [1, 2], [3, 4]]",
      "output": "2",
      "explanation": "Nodes 0, 1, 2 are one component and nodes 3, 4 are another."
    },
    {
      "input": "n = 5, edges = [[0, 1], [1, 2], [2, 3], [3, 4]]",
      "output": "1"
    }
  ],
  "constraints": [
    "`1 <= n <= 2 * 10**4`",
    "`0 <= len(edges) <= 2 * 10**4`",
    "`0 <= a, b < n` and `a != b`",
    "There are no repeated edges."
  ],
  "comparison": "exact",
