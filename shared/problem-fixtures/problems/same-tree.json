{
  "id": "same-tree",
  "title": "Same Tree",
  "difficulty": "Easy",
  "topic": "Trees",
  "description": "Given the roots of two binary trees `p` and `q`, return `True` if they are the **same tree**: the same shape, and the same value in every matching node. Otherwise return `False`.\n\nA `TreeNode` class with `val`, `left` and `right` is provided for you. In the examples below, trees are written in level-order with `None` for a missing child.",
  "function_signature": {
    "name": "is_same_tree",
    "params": [
      {
        "name": "p",
        "type": "Optional[TreeNode]"
      },
      {
        "name": "q",
        "type": "Optional[TreeNode]"
      }
    ],
    "return_type": "bool"
  },
  "starter_code": "from typing import List, Optional\n\n\ndef is_same_tree(p: Optional[TreeNode], q: Optional[TreeNode]) -> bool:\n    # TreeNode(val, left, right) is already defined for you.\n    pass\n",
  "examples": [
    {
      "input": "p = [1, 2, 3], q = [1, 2, 3]",
      "output": "True"
    },
    {
      "input": "p = [1, 2], q = [1, None, 2]",
      "output": "False",
      "explanation": "The shapes differ: 2 is a left child in one tree and a right child in the other."
    }
  ],
  "constraints": [
    "`0 <= number of nodes in each tree <= 100`",
    "`-10**4 <= Node.val <= 10**4`"
  ],
  "comparison": "exact",
  "test_cases": [
    {
      "id": 1,
      "args": [
        [
          1,
          2,
          3
        ],
        [
          1,
          2,
          3
        ]
      ],
      "expected": true
    },
    {
      "id": 2,
      "args": [
        [
          1,
          2
        ],
        [
          1,
          null,
          2
        ]
      ],
      "expected": false
    },
    {
      "id": 3,
      "args": [
        [
          1,
          2,
          1
        ],
        [
          1,
          1,
          2
        ]
      ],
      "expected": false
    },
    {
      "id": 4,
      "args": [
        [],
        []
      ],
      "expected": true
    },
    {
      "id": 5,
      "args": [
        [
          1
        ],
        []
      ],
      "expected": false
    },
    {
      "id": 6,
      "args": [
        [
          4,
          2,
          7,
          1,
          3,
          6,
          9
        ],
        [
          4,
          2,
          7,
          1,
          3,
          6,
          9
        ]
      ],
      "expected": true
    },
    {
      "id": 7,
      "args": [
        [
          1,
          null,
          2
        ],
        [
          1,
          null,
          2
        ]
      ],
      "expected": true
    },
    {
      "id": 8,
      "args": [
        [
          1,
          2,
          3
        ],
        [
          1,
          2,
          4
        ]
      ],
      "expected": false
    }
  ]
}
