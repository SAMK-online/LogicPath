{
  "id": "binary-search",
  "title": "Binary Search",
  "difficulty": "Easy",
  "topic": "Binary search",
  "description": "Given a list of integers `nums` sorted in **ascending** order and an integer `target`, return the index of `target` in `nums`, or `-1` if it is not present.\n\nYour algorithm should run in `O(log n)` time.",
  "function_signature": {
    "name": "search",
    "params": [
      {
        "name": "nums",
        "type": "List[int]"
      },
      {
        "name": "target",
        "type": "int"
      }
    ],
    "return_type": "int"
  },
  "starter_code": "from typing import List\n\n\ndef search(nums: List[int], target: int) -> int:\n    # Write your solution here\n    pass\n",
  "examples": [
    {
      "input": "nums = [-1, 0, 3, 5, 9, 12], target = 9",
      "output": "4"
    },
    {
      "input": "nums = [-1, 0, 3, 5, 9, 12], target = 2",
      "output": "-1"
    }
  ],
  "constraints": [
    "`1 <= len(nums) <= 10**6`",
    "All values in `nums` are unique.",
    "`nums` is sorted in ascending order."
  ],
  "comparison": "exact",
  "test_cases": [
