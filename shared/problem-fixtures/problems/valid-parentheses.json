{
  "id": "valid-parentheses",
  "title": "Valid Parentheses",
  "difficulty": "Easy",
  "topic": "Stacks",
  "description": "Given a string `s` containing only the characters `'('`, `')'`, `'{'`, `'}'`, `'['` and `']'`, determine whether it is valid.\n\nA string is valid when:\n\n- every opening bracket is closed by the same type of bracket,\n- brackets are closed in the correct order,\n- every closing bracket has a matching opening bracket.",
  "function_signature": {
    "name": "is_valid",
    "params": [
      {
        "name": "s",
        "type": "str"
      }
    ],
    "return_type": "bool"
  },
  "starter_code": "def is_valid(s: str) -> bool:\n    # Write your solution here\n    pass\n",
  "examples": [
    {
      "input": "s = \"()[]{}\"",
      "output": "True"
    },
    {
      "input": "s = \"(]\"",
      "output": "False"
    },
    {
      "input": "s = \"([)]\"",
      "output": "False"
    }
  ],
  "constraints": [
    "`1 <= len(s) <= 2 * 10**5`",
    "`s` consists only of the six bracket characters."
  ],
  "comparison": "exact",
  "test_cases": [
    {
      "id": 1,
      "args": [
        "()"
      ],
      "expected": true
    },
    {
      "id": 2,
      "args": [
        "()[]{}"
      ],
      "expected": true
    },
    {
      "id": 3,
      "args": [
        "(]"
      ],
      "expected": false
    },
    {
      "id": 4,
      "args": [
        "([)]"
      ],
      "expected": false
    },
    {
      "id": 5,
      "args": [
        "{[]}"
      ],
      "expected": true
    },
    {
      "id": 6,
      "args": [
        "("
      ],
      "expected": false
    },
    {
      "id": 7,
      "args": [
        "]"
      ],
      "expected": false
    },
    {
      "id": 8,
      "args": [
        "(((((())))))"
      ],
      "expected": true
    },
    {
      "id": 9,
      "args": [
        {
          "$gen": "concat",
          "parts": [
            {
              "$gen": "repeat",
              "of": "(",
              "times": 100000
            },
            {
              "$gen": "repeat",
              "of": ")",
              "times": 100000
            }
          ]
        }
      ],
      "expected": true,
      "perf": true,
      "label": "Deeply nested: 200,000 characters",
      "time_limit_ms": 1000
    },
    {
      "id": 10,
      "args": [
        {
          "$gen": "concat",
          "parts": [
            {
              "$gen": "repeat",
              "of": "{[(",
              "times": 33000
            },
            {
              "$gen": "repeat",
              "of": ")]}",
              "times": 33000
            }
          ]
        }
      ],
      "expected": true,
      "perf": true,
      "label": "Deeply nested with three kinds of brackets",
      "time_limit_ms": 1000
    },
    {
      "id": 11,
      "args": [
        {
          "$gen": "concat",
          "parts": [
            {
              "$gen": "concat",
              "parts": [
                {
                  "$gen": "repeat",
                  "of": "(",
                  "times": 100000
                },
                {
                  "$gen": "repeat",
                  "of": ")",
                  "times": 100000
                }
              ]
            },
            ")"
          ]
        }
      ],
      "expected": false,
      "perf": true,
      "label": "Deeply nested with one extra closing bracket",
      "time_limit_ms": 1000
    }
  ]
}
