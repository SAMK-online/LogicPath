  "examples": [
    {
      "input": "nums = [-2, 1, -3, 4, -1, 2, 1, -5, 4]",
      "output": "6",
      "explanation": "The subarray [4, -1, 2, 1] has the largest sum 6."
    },
    {
      "input": "nums = [1]",
      "output": "1"
    }
  ],
  "constraints": [
    "`1 <= len(nums) <= 10**5`",
    "`-10**4 <= nums[i] <= 10**4`"
  ],
  "comparison": "exact",
